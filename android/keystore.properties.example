# Release signing credentials. Copy to `keystore.properties` (gitignored) and
# fill in the two password lines; that file is the only place the passwords
# live, and it must never be committed.
#
#   cp keystore.properties.example keystore.properties
#
# Every value also has an env-var equivalent, which wins nothing over this file
# but lets a build avoid writing the password to disk at all:
#
#   DAILYNEWS_STORE_FILE / DAILYNEWS_STORE_PASSWORD
#   DAILYNEWS_KEY_ALIAS  / DAILYNEWS_KEY_PASSWORD
#
# With neither source configured, `:app:assembleRelease` still succeeds and
# produces app-release-unsigned.apk. A half-filled keystore.properties, by
# contrast, fails the build on purpose — see app/build.gradle.kts.

# Absolute path, or `~/`-prefixed, or relative to the android/ directory.
storeFile=~/dailynews-release.jks
keyAlias=dailynews

storePassword=
# Leave blank if you pressed RETURN at keytool's "same as keystore password".
keyPassword=
