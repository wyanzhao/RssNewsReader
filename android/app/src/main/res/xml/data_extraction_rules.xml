<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- provider_settings travels with provider_keys or not at all: restoring the
         settings alone leaves the app looking configured while every run fails
         on a missing key, with no way back into onboarding.

         Database and report files are excluded as well, for three independent reasons:
         1. Size. report_items has no retention period today, so half a year can push the
            database past the 25 MB cloud backup quota; once crossed, auto-backup for the
            **entire** app fails silently and even settings stop being backed up.
         2. Privacy. It holds the complete reading history and every scraped article body;
            there is no reason to send that to the cloud.
         3. Consistency. Room runs WAL, and without a BackupAgent the live SQLite files are
            copied as-is, so a restore can be a torn database.
         Users have a first-class path for moving devices: the state export ZIP in settings,
         which is a transactional snapshot. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="provider_keys.xml" />
        <exclude domain="sharedpref" path="provider_settings.xml" />
        <exclude domain="database" path="dailynews.db" />
        <exclude domain="database" path="dailynews.db-wal" />
        <exclude domain="database" path="dailynews.db-shm" />
        <exclude domain="file" path="reports" />
        <exclude domain="file" path="backup" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="provider_keys.xml" />
        <exclude domain="sharedpref" path="provider_settings.xml" />
        <exclude domain="database" path="dailynews.db" />
        <exclude domain="database" path="dailynews.db-wal" />
        <exclude domain="database" path="dailynews.db-shm" />
        <exclude domain="file" path="reports" />
        <exclude domain="file" path="backup" />
    </device-transfer>
</data-extraction-rules>
